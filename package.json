{
  "name": "toolshop-playwright-js",
  "version": "1.0.0",
  "description": "UI and API tests for practicesoftwaretesting.com (Toolshop) with Playwright",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed --project=ui",
    "test:ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint ."
  },
  "author": "Oleksii Syrotkin",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-plugin-playwright": "^2.1.0",
    "globals": "^15.14.0"
  }
}
